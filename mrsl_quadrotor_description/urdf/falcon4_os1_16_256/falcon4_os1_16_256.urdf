      </ray>
      <plugin filename="libgazebo_ros_ouster_laser.so" name="gazebo_ros_laser_controller">
        <topicName>falcon4/os1_cloud_node/points</topicName>
        <robotNamespace>/</robotNamespace>
        <frameName>os1_lidar</frameName>
        <min_range>0.9</min_range>
        <max_range>75.0</max_range>
        <gaussianNoise>0.008</gaussianNoise>
      </plugin>
    </sensor> -->
    <sensor name='os1_lidar' type='gpu_lidar'>
      <topic>falcon4/os1_cloud_node/points</topic>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <always_on>1</always_on>
      <lidar>
          <scan>
              <horizontal>
                  <samples>256</samples>
                  <resolution>1</resolution>
                  <min_angle>-3.141592653589793</min_angle>
                  <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                  <samples>16</samples>
                  <resolution>1</resolution>
                  <min_angle>-0.26</min_angle>
                  <max_angle>0.26</max_angle>
              </vertical>
          </scan>
          <range>
              <min>0.08</min>
              <max>75.0</max>
              <resolution>0.03</resolution>
          </range>
      </lidar>
    </sensor>
  </gazebo>
  <!-- IMU -->
  <gazebo reference="os1_imu">
    <!-- <plugin filename="libhector_gazebo_ros_imu.so" name="imu_controller">
      <robotNamespace>/</robotNamespace>
      <updateRate>100.0</updateRate>
      <bodyName>os1_imu</bodyName>
      <topicName>falcon4/os1_cloud_node/imu</topicName>
      <accelDrift>0.005 0.005 0.005</accelDrift>
      <accelGaussianNoise>0.005 0.005 0.005</accelGaussianNoise>
      <rateDrift>0.005 0.005 0.005 </rateDrift>
      <rateGaussianNoise>0.005 0.005 0.005 </rateGaussianNoise>
      <headingDrift>0.005</headingDrift>
      <headingGaussianNoise>0.005</headingGaussianNoise>
    </plugin> -->
    
    <sensor name="os1_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>100.0</update_rate>
      <visualize>true</visualize>
      <topic>falcon4/os1_cloud_node/imu</topic>
      <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- Plugins -->
  <gazebo>
    <!-- Quad Dynamics Plugin -->
    <plugin filename="libmrsl_quadrotor_propulsion.so" name="quadrotor_propulsion">
      <command_topic>so3_cmd</command_topic>
      <odom_topic>ground_truth/odom</odom_topic>
    </plugin>
    <!-- Quad Ground Truth Plugin -->
    <!-- <plugin filename="libgazebo_ros_p3d.so" name="quadrotor_groundtruth_sim">
      <updateRate>100.0</updateRate>
      <bodyName>base_link</bodyName>
      <topicName>ground_truth/odom</topicName>
      <gaussianNoise>0.0</gaussianNoise>
      <frameName>world</frameName>
    </plugin> -->
    <!-- Quad Ground Truth Plugin -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher" >
      <odom_publish_frequency>100.0</odom_publish_frequency>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>falcon4/ground_truth/odom</odom_topic>
      <gaussian_noise>0.0</gaussian_noise>
      <odom_frame>world</odom_frame>
    </plugin>
  </gazebo>

  <!-- GPS Sensor -->
  <gazebo reference="base_link">
    <!-- <plugin filename="libhector_gazebo_ros_gps.so" name="novatel_gps_sim">
      <alwaysOn>1</alwaysOn>
      <updateRate>10.0</updateRate>
      <bodyName>base_link</bodyName>
      <topicName>GPS_Fix</topicName>
      <velocityTopicName>fix_velocity</velocityTopicName>
      <drift>5.0 5.0 5.0</drift>
      <gaussianNoise>0.1 0.1 0.1</gaussianNoise>
      <velocityDrift>0 0 0</velocityDrift>
      <velocityGaussianNoise>0.1 0.1 0.1</velocityGaussianNoise>
    </plugin> -->
    <sensor name="gps_sim" type="gps">
      <always_on>1</always_on>
      <update_rate>10.0</update_rate>
      <topic>GPS_Fix</topic>
      <!-- todo add noise parameters-->
    </sensor>
  </gazebo>
</robot>
